<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="0"
                android:startColor="@color/chip_selected_start"
                android:endColor="@color/chip_selected_end" />
            <stroke
                android:width="1dp"
                android:color="@color/chip_selected_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/chip_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/chip_border" />
        </shape>
    </item>
</selector>
