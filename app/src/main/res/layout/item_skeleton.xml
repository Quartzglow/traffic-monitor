<?xml version="1.0" encoding="utf-8"?>
<com.example.trafficmonitor.ui.GlassLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:glassRadius="22dp"
    app:glassShadow="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <View
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_icon_tile" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="150dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="96dp"
                android:layout_height="9dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_skeleton_block" />
        </LinearLayout>
    </LinearLayout>
</com.example.trafficmonitor.ui.GlassLayout>
