<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TrafficMonitor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/background</item>
        <item name="colorTertiary">@color/accent_coral</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>

        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="fontFamily">@font/manrope_regular</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActionModeOverlay">true</item>

        <item name="colorControlHighlight">@color/ripple</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TM.Dialog</item>
    </style>

    <style name="ThemeOverlay.TM.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TM.Dialog</item>
    </style>

    <style name="ShapeAppearance.TM.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>
